<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>DxS Connect</title>
  <script src="https://telegram.org/js/telegram-web-app.js?56"></script>
  <style>
    /* ===== TELEGRAM THEME TOKENS ===== */
    :root {
      /* Core Telegram colors (auto-mapped from tg.themeParams) */
      --tg-theme-bg-color: #ffffff;
      --tg-theme-secondary-bg-color: #f4f4f5;
      --tg-theme-text-color: #000000;
      --tg-theme-hint-color: #8e8e93;
      --tg-theme-link-color: #3390ec;
      --tg-theme-button-color: #3390ec;
      --tg-theme-button-text-color: #ffffff;
      --tg-theme-destructive-text-color: #ff3b30;
      --tg-theme-section-bg-color: #ffffff;
      --tg-theme-section-header-text-color: #6d6d72;
      --tg-theme-section-separator-color: #c8c7cc;
      --tg-theme-accent-text-color: #3390ec;

      /* Telegram layout tokens */
      --tg-section-padding: 16px;
      --tg-list-item-padding: 11px 16px;
      --tg-radius: 12px;
      --tg-radius-sm: 8px;
      --tg-font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      height: 100%;
      font-family: var(--tg-font-family);
      background: var(--tg-theme-bg-color);
      color: var(--tg-theme-text-color);
      overflow: hidden;
      overscroll-behavior: none;
    }

    body {
      position: relative;
      display: flex;
      flex-direction: column;
    }

    /* ===== SCREENS ===== */
    .screen {
      position: absolute;
      inset: 0;
      display: none;
      flex-direction: column;
      height: 100%;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      background: var(--tg-theme-bg-color);
      overscroll-behavior: contain;
    }
    .screen.active { display: flex; }

    /* ===== TELEGRAM-STYLE HEADER ===== */
    .tg-header {
      padding: 16px var(--tg-section-padding) 8px;
      position: sticky;
      top: 0;
      background: var(--tg-theme-bg-color);
      z-index: 10;
    }

    .tg-header.with-back {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .tg-back-btn {
      width: 36px;
      height: 36px;
      border: none;
      background: none;
      color: var(--tg-theme-button-color);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-left: -8px;
      border-radius: var(--tg-radius-sm);
    }
    .tg-back-btn:active { background: rgba(0,0,0,0.05); }

    .tg-title {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.3px;
      line-height: 1.2;
    }

    .tg-subtitle {
      font-size: 14px;
      color: var(--tg-theme-hint-color);
      margin-top: 4px;
      line-height: 1.3;
    }

    /* ===== TELEGRAM-STYLE SECTIONS ===== */
    .tg-section {
      margin-bottom: 20px;
    }

    .tg-section-header {
      font-size: 13px;
      font-weight: 600;
      color: var(--tg-theme-section-header-text-color);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      padding: 0 var(--tg-section-padding) 6px;
    }

    .tg-section-body {
      background: var(--tg-theme-section-bg-color);
      border-radius: var(--tg-radius);
      margin: 0 var(--tg-section-padding);
      overflow: hidden;
    }

    /* ===== TELEGRAM-STYLE LIST ITEMS ===== */
    .tg-list-item {
      display: flex;
      align-items: center;
      padding: var(--tg-list-item-padding);
      gap: 12px;
      cursor: pointer;
      position: relative;
      transition: background 0.12s;
      min-height: 44px;
    }
    .tg-list-item:active { background: var(--tg-theme-secondary-bg-color); }

    .tg-list-item:not(:last-child)::after {
      content: "";
      position: absolute;
      left: 16px;
      right: 0;
      bottom: 0;
      height: 0.5px;
      background: var(--tg-theme-section-separator-color);
    }

    /* Иконки — однотонные, в стиле Telegram */
    .tg-list-icon {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: var(--tg-theme-hint-color);
    }

    .tg-list-text {
      flex: 1;
      min-width: 0;
    }

    .tg-list-title {
      font-size: 17px;
      font-weight: 400;
      line-height: 1.25;
    }

    .tg-list-subtitle {
      font-size: 14px;
      color: var(--tg-theme-hint-color);
      margin-top: 1px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.3;
    }

    .tg-list-value {
      font-size: 16px;
      color: var(--tg-theme-hint-color);
      margin-left: auto;
      padding-left: 8px;
      flex-shrink: 0;
    }

    .tg-list-arrow {
      color: var(--tg-theme-hint-color);
      opacity: 0.5;
      display: flex;
      flex-shrink: 0;
    }

    /* ===== TELEGRAM-STYLE STATS ===== */
    .tg-stats {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      padding: 16px 0;
      position: relative;
    }

    .tg-stats::before,
    .tg-stats::after {
      content: "";
      position: absolute;
      top: 20%;
      bottom: 20%;
      width: 0.5px;
      background: var(--tg-theme-section-separator-color);
    }
    .tg-stats::before { left: 33.333%; }
    .tg-stats::after  { left: 66.666%; }

    .tg-stat {
      text-align: center;
      padding: 0 6px;
    }

    .tg-stat-label {
      font-size: 13px;
      color: var(--tg-theme-hint-color);
      margin-bottom: 4px;
    }

    .tg-stat-value {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.2;
    }

    /* ===== TELEGRAM-STYLE BUTTONS ===== */
    .tg-btn {
      width: 100%;
      height: 50px;
      border: none;
      border-radius: var(--tg-radius);
      font-size: 17px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.15s;
      font-family: inherit;
    }
    .tg-btn:active { opacity: 0.8; }

    .tg-btn-primary {
      background: var(--tg-theme-button-color);
      color: var(--tg-theme-button-text-color);
    }

    .tg-btn-secondary {
      background: var(--tg-theme-secondary-bg-color);
      color: var(--tg-theme-button-color);
    }

    .tg-btn-destructive {
      background: transparent;
      color: var(--tg-theme-destructive-text-color);
      font-weight: 500;
    }

    /* ===== STATUS DOT ===== */
    .tg-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #34c759;
      box-shadow: 0 0 0 3px rgba(52,199,89,0.2);
      flex-shrink: 0;
    }

    /* ===== CONTENT PADDING ===== */
    .tg-content {
      padding: 8px var(--tg-section-padding) 24px;
    }

    .screen.no-nav {
      padding-bottom: calc(24px + env(safe-area-inset-bottom));
    }

    /* ===== NAV ISLAND (упрощённый, в стиле Telegram) ===== */
    .nav-island {
      position: fixed;
      left: 50%;
      bottom: calc(14px + env(safe-area-inset-bottom));
      transform: translateX(-50%);
      height: 60px;
      padding: 6px;
      display: none;
      align-items: center;
      justify-content: space-around;
      gap: 2px;
      border-radius: 50px;
      background: var(--tg-theme-secondary-bg-color);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 0.5px solid var(--tg-theme-section-separator-color);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      z-index: 60;
      min-width: 260px;
      max-width: calc(100vw - 32px);
      contain: layout paint;
    }
    .nav-island.visible { display: flex; }

    .nav-btn {
      position: relative;
      z-index: 2;
      flex: 1;
      height: 100%;
      padding: 0 12px;
      border: none;
      background: transparent;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      font-size: 10px;
      font-weight: 500;
      cursor: pointer;
      border-radius: 50px;
      white-space: nowrap;
      pointer-events: none;
      color: var(--tg-theme-hint-color);
      -webkit-font-smoothing: antialiased;
    }

    .nav-btn.active {
      color: var(--tg-theme-button-color);
    }

    .nav-btn svg {
      display: block;
      width: 22px;
      height: 22px;
    }

    .nav-lens {
      position: absolute;
      top: 6px;
      left: 0;
      height: calc(60px - 12px);
      border-radius: 50px;
      background: var(--tg-theme-bg-color);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      z-index: 1;
      pointer-events: none;
      will-change: transform, width;
      transform: translate3d(0, 0, 0);
      transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1),
                  width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    }
    .nav-island.dragging .nav-lens { transition: none; }

    /* ===== MODAL SHEET ===== */
    .sheet-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      z-index: 100;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s, visibility 0.25s;
    }
    .sheet-overlay.open { opacity: 1; visibility: visible; }

    .sheet {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--tg-theme-bg-color);
      border-radius: 16px 16px 0 0;
      padding: 12px 16px calc(16px + env(safe-area-inset-bottom));
      transform: translateY(100%);
      transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
    }
    .sheet-overlay.open .sheet { transform: translateY(0); }

    .sheet-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--tg-theme-hint-color);
      text-align: center;
      margin-bottom: 12px;
      text-transform: uppercase;
    }

    .sheet-btn {
      width: 100%;
      height: 50px;
      border: none;
      border-radius: var(--tg-radius);
      background: var(--tg-theme-secondary-bg-color);
      color: var(--tg-theme-text-color);
      font-size: 17px;
      font-weight: 500;
      cursor: pointer;
      margin-bottom: 8px;
      font-family: inherit;
    }

    .sheet-btn.danger { color: var(--tg-theme-destructive-text-color); }
    .sheet-btn.cancel {
      background: transparent;
      color: var(--tg-theme-button-color);
      font-weight: 600;
    }
  </style>
</head>
<body>

  <!-- ==================== HOME ==================== -->
  <div class="screen active" id="screen-home">
    <!-- Telegram-style header -->
    <header class="tg-header">
      <div class="tg-title">DxS Connect</div>
      <div class="tg-subtitle">По-настоящему быстрый интернет</div>
    </header>

    <!-- Подписка -->
    <section class="tg-section">
      <div class="tg-section-header">Подписка</div>
      <div class="tg-section-body">
        <div class="tg-list-item" style="cursor: default;">
          <span class="tg-status-dot"></span>
          <div class="tg-list-text">
            <div class="tg-list-title">Активна</div>
            <div class="tg-list-subtitle">1 месяц · осталось 24 дня</div>
          </div>
          <div class="tg-list-value">12.10.2025</div>
        </div>
        <div class="tg-stats">
          <div class="tg-stat">
            <div class="tg-stat-label">Тариф</div>
            <div class="tg-stat-value">1 месяц</div>
          </div>
          <div class="tg-stat">
            <div class="tg-stat-label">Осталось</div>
            <div class="tg-stat-value">24 дня</div>
          </div>
          <div class="tg-stat">
            <div class="tg-stat-label">Действует до</div>
            <div class="tg-stat-value">12.10.25</div>
          </div>
        </div>
        <div style="padding: 0 16px 16px;">
          <button class="tg-btn tg-btn-primary" data-go="subscription">
            Управление подпиской
          </button>
        </div>
      </div>
    </section>

    <!-- Меню -->
    <section class="tg-section">
      <div class="tg-section-header">Сервис</div>
      <div class="tg-section-body">
        <div class="tg-list-item" data-go="tariffs">
          <div class="tg-list-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="5" width="20" height="14" rx="2"/>
              <path d="M2 10h20"/>
            </svg>
          </div>
          <div class="tg-list-text">
            <div class="tg-list-title">Тарифы</div>
            <div class="tg-list-subtitle">Выбрать или продлить план</div>
          </div>
          <div class="tg-list-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>

        <div class="tg-list-item" data-go="devices">
          <div class="tg-list-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="12" height="9" rx="1.5"/>
              <path d="M1.5 17h15"/>
              <rect x="16" y="9" width="6.5" height="11" rx="1.5"/>
              <path d="M18.2 18.2h2.1"/>
            </svg>
          </div>
          <div class="tg-list-text">
            <div class="tg-list-title">Мои устройства</div>
            <div class="tg-list-subtitle">Управление подключёнными устройствами</div>
          </div>
          <div class="tg-list-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>

        <div class="tg-list-item" data-go="connection">
          <div class="tg-list-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
              <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
              <circle cx="12" cy="20" r="1"/>
            </svg>
          </div>
          <div class="tg-list-text">
            <div class="tg-list-title">Подключение</div>
            <div class="tg-list-subtitle">Конфигурации и инструкции</div>
          </div>
          <div class="tg-list-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>

        <div class="tg-list-item" data-go="promo">
          <div class="tg-list-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V4a1 1 0 0 1 1-1h9l7.6 7.6a2 2 0 0 1 0 2.8z"/>
              <circle cx="7.8" cy="7.8" r="1.4"/>
            </svg>
          </div>
          <div class="tg-list-text">
            <div class="tg-list-title">Промокод</div>
            <div class="tg-list-subtitle">Активировать бонусный код</div>
          </div>
          <div class="tg-list-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>

        <div class="tg-list-item" data-go="help">
          <div class="tg-list-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"/>
              <path d="M9.5 9.2a2.5 2.5 0 0 1 4.86.83c0 1.67-2.5 2.14-2.5 3.6"/>
              <circle cx="12" cy="17" r="0.6" fill="currentColor"/>
            </svg>
          </div>
          <div class="tg-list-text">
            <div class="tg-list-title">Помощь</div>
            <div class="tg-list-subtitle">FAQ и поддержка</div>
          </div>
          <div class="tg-list-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </div>
        </div>
      </div>
    </section>

    <div style="height: 100px;"></div>
  </div>

  <!-- ==================== NAV ISLAND ==================== -->
  <nav class="nav-island visible" id="nav-island">
    <div class="nav-lens" id="nav-lens"></div>

    <button class="nav-btn active" data-tab="home">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 10.5L12 3l9 7.5"/>
        <path d="M5 9.5V21h14V9.5"/>
      </svg>
      <span>Главное</span>
    </button>

    <button class="nav-btn" data-tab="subscription">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="5" width="20" height="14" rx="2"/>
        <path d="M2 10h20"/>
      </svg>
      <span>Подписки</span>
    </button>

    <button class="nav-btn" data-tab="settings">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="4"/>
        <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
      </svg>
      <span>Профиль</span>
    </button>
  </nav>

  <script>
    (function() {
      if (!window.Telegram || !window.Telegram.WebApp) {
        window.Telegram = {
          WebApp: {
            ready: () => {},
            expand: () => {},
            themeParams: {},
            colorScheme: 'light',
            initDataUnsafe: { user: { first_name: 'User', username: 'username', photo_url: null } },
            showAlert: (m) => alert(m),
            BackButton: { show: () => {}, hide: () => {}, onClick: () => {}, offClick: () => {} },
            HapticFeedback: {
              impactOccurred: () => {},
              notificationOccurred: () => {},
              selectionChanged: () => {}
            }
          }
        };
      }

      const tg = window.Telegram.WebApp;
      tg.ready();
      tg.expand();

      // ===== AUTO-MAP THEME PARAMS =====
      if (tg.themeParams) {
        const root = document.documentElement;
        const map = {
          bg_color: '--tg-theme-bg-color',
          secondary_bg_color: '--tg-theme-secondary-bg-color',
          text_color: '--tg-theme-text-color',
          hint_color: '--tg-theme-hint-color',
          link_color: '--tg-theme-link-color',
          button_color: '--tg-theme-button-color',
          button_text_color: '--tg-theme-button-text-color',
          destructive_text_color: '--tg-theme-destructive-text-color',
          section_bg_color: '--tg-theme-section-bg-color',
          section_header_text_color: '--tg-theme-section-header-text-color',
          section_separator_color: '--tg-theme-section-separator-color',
          accent_text_color: '--tg-theme-accent-text-color'
        };
        for (const [k, v] of Object.entries(map)) {
          if (tg.themeParams[k]) root.style.setProperty(v, tg.themeParams[k]);
        }
      }

      // ===== HAPTIC =====
      function haptic(type) {
        try {
          const hf = tg.HapticFeedback;
          if (!hf) return;
          if (type === 'light') hf.impactOccurred('light');
          else if (type === 'medium') hf.impactOccurred('medium');
          else if (type === 'success') hf.notificationOccurred('success');
          else if (type === 'error') hf.notificationOccurred('error');
          else if (type === 'select') hf.selectionChanged();
        } catch (e) {}
      }

      // ===== NAV ISLAND =====
      const island = document.getElementById('nav-island');
      const lens = document.getElementById('nav-lens');
      const buttons = Array.from(island.querySelectorAll('.nav-btn'));

      let geo = null;
      let hoverTab = 'home';
      let currentTab = 'home';

      function rebuildGeometry() {
        const ir = island.getBoundingClientRect();
        if (ir.width === 0) return;

        const bs = buttons.map(b => {
          const r = b.getBoundingClientRect();
          return {
            tab: b.dataset.tab,
            left: r.left - ir.left,
            width: r.width,
            center: r.left - ir.left + r.width / 2
          };
        });

        const mids = [];
        for (let i = 0; i < bs.length - 1; i++) {
          mids.push((bs[i].center + bs[i + 1].center) / 2);
        }

        geo = { islandW: ir.width, buttons: bs, mids };
      }

      function btnByTab(tab) {
        return geo && geo.buttons.find(b => b.tab === tab);
      }

      function applyLens(left, width, useTransition) {
        lens.style.transition = useTransition ? '' : 'none';
        lens.style.transform = `translate3d(${left}px, 0, 0)`;
        lens.style.width = width + 'px';
      }

      function snapTo(tab, useTransition) {
        const b = btnByTab(tab);
        if (!b) return;
        applyLens(b.left, b.width, useTransition);

        buttons.forEach(btn => {
          btn.classList.toggle('active', btn.dataset.tab === tab);
        });
      }

      function tabFromCenter(x) {
        if (!geo) return currentTab;
        if (x < geo.mids[0]) return geo.buttons[0].tab;
        if (x > geo.mids[geo.mids.length - 1]) return geo.buttons[geo.buttons.length - 1].tab;
        for (let i = 0; i < geo.mids.length - 1; i++) {
          if (x >= geo.mids[i] && x <= geo.mids[i + 1]) return geo.buttons[i + 1].tab;
        }
        let best = geo.buttons[0], bd = Infinity;
        for (const b of geo.buttons) {
          const d = Math.abs(b.center - x);
          if (d < bd) { bd = d; best = b; }
        }
        return best.tab;
      }

      let pointerId = null;
      let startX = 0;
      let pendingX = 0;
      let didDrag = false;
      const DRAG_THRESHOLD = 8;

      function pointerToLocal(clientX) {
        const ir = island.getBoundingClientRect();
        return clientX - ir.left;
      }

      function onPointerDown(e) {
        if (pointerId !== null) return;
        if (!geo) rebuildGeometry();
        if (!geo) return;

        pointerId = e.pointerId;
        try { island.setPointerCapture(pointerId); } catch (_) {}

        const localX = pointerToLocal(e.clientX);
        startX = localX;
        pendingX = localX;
        didDrag = false;
      }

      function onPointerMove(e) {
        if (e.pointerId !== pointerId) return;

        const localX = pointerToLocal(e.clientX);
        const dxTotal = Math.abs(localX - startX);

        if (!didDrag && dxTotal > DRAG_THRESHOLD) {
          didDrag = true;
          island.classList.add('dragging');
        }
        if (!didDrag) return;

        pendingX = localX;
        const targetTab = tabFromCenter(localX);
        const b = btnByTab(targetTab);
        if (!b) return;

        applyLens(b.left, b.width, false);

        if (hoverTab !== targetTab) {
          hoverTab = targetTab;
          haptic('select');
        }
      }

      function onPointerUp(e) {
        if (e.pointerId !== pointerId) return;
        try { island.releasePointerCapture(pointerId); } catch (_) {}
        island.classList.remove('dragging');
        pointerId = null;

        if (didDrag) {
          commit(hoverTab);
        } else {
          commit(tabFromCenter(pointerToLocal(e.clientX)));
        }
      }

      function commit(tab) {
        if (tab === currentTab) {
          snapTo(currentTab, true);
          return;
        }

        haptic('light');
        currentTab = tab;
        snapTo(tab, true);
      }

      island.addEventListener('pointerdown', onPointerDown);
      island.addEventListener('pointermove', onPointerMove);
      island.addEventListener('pointerup', onPointerUp);
      island.addEventListener('pointercancel', onPointerUp);

      island.addEventListener('touchstart', (e) => e.preventDefault(), { passive: false });

      // ===== BACK BUTTON =====
      const backBtn = document.querySelector('[data-back]');
      if (backBtn && tg.BackButton) {
        // Показываем нативная кнопка "Назад" только когда есть куда возвращаться
        // В Telegram Web App это делается через tg.BackButton.show()
      }

      // ===== INIT =====
      function init() {
        rebuildGeometry();
        snapTo('home', false);
      }

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => requestAnimationFrame(init));
      }
      requestAnimationFrame(init);
      window.addEventListener('load', () => requestAnimationFrame(init));
      window.addEventListener('resize', () => {
        if (pointerId === null) {
          rebuildGeometry();
          snapTo(currentTab, false);
        }
      });

    })();
  </script>
</body>
</html>
